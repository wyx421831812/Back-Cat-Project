/* ============================================================
   BackPet 亮色主题 (黄 #FBBF24 / 紫 #8B5CF6)
   暗色规则见 styles-dark.qss; 两文件公共规则保持同步。
   ============================================================ */

/* 全局: 透明窗口(桌宠/WebEngine)安全规则
   QStyleSheetStyle 会给无背景规则的 QWidget 画不透默认背景，
   顶层常规窗口用更具体的 #id / 类选择器显式覆盖。 */
QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #27233A;
    background: transparent;
}

/* ---------------- 顶层窗口 ---------------- */
#preferenceWindow {
    background: #F6F4FA;
}
#preferenceSidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FEF9E7, stop:1 #F1ECFB);
    border: none;
}
#preferenceContent {
    background: #F6F4FA;
}
QDialog {
    background: #F6F4FA;
}
QMessageBox {
    background: #FFFFFF;
}

/* ---------------- 菜单 / 提示 ---------------- */
QMenu {
    background: #FFFFFF;
    border: 1px solid #E9E5F2;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 28px 7px 16px;
    border-radius: 6px;
    color: #27233A;
}
QMenu::item:selected {
    background: #F3F0FA;
    color: #6D28D9;
}
QMenu::item:checked {
    color: #7C3AED;
    font-weight: 600;
}
QMenu::separator {
    height: 1px;
    background: #E9E5F2;
    margin: 6px 10px;
}
QMenu::right-arrow {
    width: 10px;
    height: 10px;
}

QToolTip {
    background: #27233A;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 5px 9px;
}

/* ---------------- 标签 ---------------- */
QLabel {
    color: #27233A;
    background: transparent;
}
QLabel#proListTitle {
    font-size: 14px;
    font-weight: 600;
    color: #4B4765;
}
QLabel#proItemTitle {
    font-size: 13px;
    font-weight: 500;
    color: #27233A;
}
QLabel#proItemDesc {
    font-size: 12px;
    color: #A09DB4;
}
QLabel#appNameLabel {
    font-size: 13px;
    font-weight: 700;
    color: #4B4765;
}

/* ---------------- 分组卡片 ---------------- */
QFrame#proListItem {
    background: #FFFFFF;
    border: 1px solid #E9E5F2;
    border-radius: 10px;
}
QFrame#proListItem:hover {
    border-color: #D9CEF2;
}

/* ---------------- 按钮 ---------------- */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #FBBF24, stop:1 #8B5CF6);
    color: #FFFFFF;
    border: none;
    padding: 7px 18px;
    border-radius: 8px;
    font-weight: 600;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #F59E0B, stop:1 #7C3AED);
}
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #D97706, stop:1 #6D28D9);
}
QPushButton:disabled {
    background: #E3DFEC;
    color: #A09DB4;
}
QPushButton#secondaryBtn {
    background: #F1EEF8;
    color: #5B5776;
}
QPushButton#secondaryBtn:hover {
    background: #E7E2F5;
    color: #6D28D9;
}
QPushButton#ghostBtn {
    background: transparent;
    color: #7C3AED;
    border: 1px solid #D9CEF2;
}
QPushButton#ghostBtn:hover {
    background: #F6F2FF;
    border-color: #8B5CF6;
}
/* 模型卡片上的圆形小按钮 */
QPushButton#iconCircleBtn {
    background: rgba(255, 255, 255, 85%);
    border: 1px solid #E9E5F2;
    border-radius: 14px;
    padding: 0px;
}
QPushButton#iconCircleBtn:hover {
    background: #FFFFFF;
    border-color: #8B5CF6;
}

/* ---------------- 输入控件 ---------------- */
QLineEdit, QSpinBox, QComboBox {
    background: #FFFFFF;
    border: 1px solid #E0DBED;
    border-radius: 8px;
    padding: 5px 10px;
    color: #27233A;
    selection-background-color: #8B5CF6;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #8B5CF6;
}
QLineEdit:disabled, QSpinBox:disabled {
    background: #F3F1F8;
    color: #A09DB4;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8B5CF6;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E9E5F2;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    border-radius: 6px;
    padding-left: 10px;
    color: #27233A;
}
QComboBox QAbstractItemView::item:selected {
    background: #F3F0FA;
    color: #6D28D9;
}

/* 数字框去右侧大箭头(更接近原版 InputNumber) */
QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    border: none;
}

/* ---------------- 滑块 ---------------- */
QSlider::groove:horizontal {
    height: 6px;
    background: #E3DFEC;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #FBBF24, stop:1 #8B5CF6);
    border-radius: 3px;
    height: 6px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid #8B5CF6;
    width: 16px;
    height: 16px;
    margin: -7px 0;
    border-radius: 10px;
}
QSlider::handle:horizontal:hover {
    background: #F6F2FF;
    border-color: #6D28D9;
}

/* ---------------- 滚动条 ---------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: #D6D0E6;
    border-radius: 4px;
    min-height: 36px;
}
QScrollBar::handle:vertical:hover {
    background: #8B5CF6;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: #D6D0E6;
    border-radius: 4px;
    min-width: 36px;
}
QScrollBar::handle:horizontal:hover {
    background: #8B5CF6;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------------- 列表(任务签等) ---------------- */
QListWidget {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget::item {
    background: #FFFFFF;
    border: 1px solid #E9E5F2;
    border-radius: 8px;
    padding: 8px 10px;
    margin-bottom: 6px;
}
QListWidget::item:hover {
    border-color: #D9CEF2;
}
QListWidget::item:selected {
    border-color: #8B5CF6;
    background: #F6F2FF;
    color: #27233A;
}

/* ---------------- 桌宠既有挂件(保持视觉一致) ---------------- */
QWidget#clockWidget {
    background: rgba(255, 255, 255, 205);
    border-radius: 15px;
}
QLabel#clockTimeLabel {
    font-size: 28px;
    font-weight: bold;
    color: #D97706;
}
QLabel#clockDateLabel {
    font-size: 12px;
    color: #6E6A86;
}
QWidget#quoteWidget {
    background: rgba(139, 92, 246, 185);
    border-radius: 15px;
}
QLabel#quoteTextLabel {
    font-size: 14px;
    color: white;
    font-style: italic;
}
QLabel#quoteAuthorLabel {
    font-size: 11px;
    color: rgba(255, 255, 255, 205);
}
